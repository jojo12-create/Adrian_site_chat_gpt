{
  "name": "osteo-villefontaine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Site d'Adrian Rodriguez, ostéopathe à Villefontaine (38090) : HTML/CSS/JS statique, Vite, GSAP, Lenis.",
  "scripts": {
    "images": "node scripts/images.mjs",
    "pages": "node scripts/build-pages.mjs",
    "dev": "npm run pages && vite site --host 127.0.0.1",
    "build": "npm run pages && vite build site --emptyOutDir",
    "preview": "vite preview site --host 127.0.0.1 --port 4173",
    "test": "node scripts/qa.mjs",
    "build:demo": "DEMO=1 BASE=/Adrianosteo/ npm run build"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.6",
    "@fontsource-variable/manrope": "^5.2.6",
    "gsap": "^3.13.0",
    "lenis": "^1.3.4"
  },
  "devDependencies": {
    "axe-core": "^4.10.2",
    "sharp": "^0.34.2",
    "vite": "^6.3.5"
  }
}
